# Copy to .env and fill in. Nothing in this file belongs in the frontend build:
# every value here is a server secret or a server-side policy decision.
#
# The app refuses to start if APP_MODE=live and any credential this file marks
# as required for live mode is missing. That is deliberate — a half-configured
# mailing service is worse than one that is plainly off.

# ---------------------------------------------------------------- application
# demo | live
APP_MODE=demo
PUBLIC_SITE_URL=https://www.whyisthislighton.com
CONTACT_EMAIL=hello@whyisthislighton.com
LOG_LEVEL=INFO

# ------------------------------------------------------------------- database
# Production: postgresql+psycopg://user:password@host:5432/wittl
# Local without services installed: sqlite+pysqlite:///./wittl.db
DATABASE_URL=postgresql+psycopg://wittl:wittl@localhost:5432/wittl

# ----------------------------------------------------------------------- cors
# Exact origins, comma separated. Wildcards are rejected at startup.
# Add both the custom domain and the github.io project URL if you use both.
CORS_ALLOW_ORIGINS=http://localhost:5173,https://www.whyisthislighton.com

# --------------------------------------------------------------------- secret
# HMAC pepper for recipient address hashes. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# CHANGING THIS ORPHANS EVERY COOLDOWN AND DO-NOT-MAIL RECORD. Treat as permanent.
ADDRESS_PEPPER=change-me-and-never-change-it-again

# -------------------------------------------------------------------- mailing
# mock | postgrid
MAIL_PROVIDER=mock
# Required when MAIL_PROVIDER=postgrid. test_sk_… in the sandbox, live_sk_… in
# production.
POSTGRID_API_KEY=
# Optional. PostGrid's Address Verification is a separate product with its own
# key. Set it for real verification even in the sandbox; leave it blank and the
# app verifies by creating a Print & Mail contact instead (real on a live key,
# always "verified" in the sandbox).
POSTGRID_AV_API_KEY=
POSTGRID_WEBHOOK_SECRET=
# Guard rail: while true, a live_ key is refused. Set false only when you
# genuinely intend to put paper in the mail.
POSTGRID_USE_TEST_KEY_ONLY=true

# The return address printed on the envelope. NEVER a sender's address.
# Required when MAIL_PROVIDER=postgrid. Use a PO box or a business address you own.
RETURN_NAME=Why Is This Light On?
RETURN_LINE1=
RETURN_LINE2=
RETURN_CITY=
RETURN_STATE=
RETURN_ZIP=

# ------------------------------------------------------------------- payments
# none | mock | stripe
# "none" disables mailing entirely: the API will compose and price letters but
# refuse to open a checkout, which is the correct state before you have Stripe.
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# {LETTER_ID} is substituted server-side.
CHECKOUT_SUCCESS_URL=https://www.whyisthislighton.com/#/receipt?letter={LETTER_ID}
CHECKOUT_CANCEL_URL=https://www.whyisthislighton.com/#/create

# -------------------------------------------------------------------- pricing
# Server-side authority. The browser displays whatever these produce.
# Check these against your provider's current rates before going live.
PRICE_POSTAGE_CENTS=174
PRICE_PRINTING_CENTS=95
PRICE_SERVICE_CENTS=80
PRICE_CURRENCY=usd

# --------------------------------------------------------------------- policy
REPEAT_ADDRESS_COOLDOWN_DAYS=180
MAX_LETTERS_PER_ADDRESS_LIFETIME=3
RATE_LIMIT_PER_IP_PER_HOUR=12
RATE_LIMIT_DRAFTS_PER_IP_PER_DAY=30
# Days after a letter reaches a final state before the address, the letter text
# and the sender's email are erased. The address hash and outcome are kept.
RETENTION_DAYS=90

# ------------------------------------------------------- bot protection (opt)
# Cloudflare Turnstile. Leave blank to disable; strongly recommended once
# PAYMENT_PROVIDER=stripe.
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------- internal ops (opt)
# Bearer token for POST /api/v1/internal/{submit-pending,purge-expired,migrate}.
# Blank disables that router entirely. On Vercel, set this and the platform
# sends "Authorization: Bearer <this>" on every cron invocation automatically.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
