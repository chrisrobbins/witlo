# Copy to .env.local for development, or set these in the Vercel project
# (Settings -> Environment Variables).
#
# EVERY VALUE HERE IS PUBLIC. Vite inlines VITE_* variables into the JavaScript
# bundle that ships to the browser, so anyone can read them with View Source.
# API keys, mailing credentials and Stripe secret keys belong in the backend's
# environment and nowhere else. There is no exception to this.

# ---------------------------------------------------------------------- mode
# Leave BLANK for demo mode. Demo mode is the safe default: the app composes
# and prints letters entirely in the browser and has no code path that can mail
# anything or take a payment.
#
# "/"  -> the API is on this same origin (the single Vercel deployment serves
#         the site and /api/* together). This is the normal live setting.
# a full origin, e.g. https://api.witlo.info, for a separately hosted API.
VITE_API_BASE_URL=

# -------------------------------------------------------------------- contact
VITE_CONTACT_EMAIL=hello@witlo.info

# ----------------------------------------------------------------- base path
# The site is served from the domain root on Vercel, so this stays "/". It only
# ever needs changing to host the static build under a sub-path.
# VITE_BASE_PATH=/
