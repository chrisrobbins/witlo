# Copy to .env.local for development, or set these in the GitHub Actions
# workflow for deployment.
#
# EVERY VALUE HERE IS PUBLIC. Vite inlines VITE_* variables into the JavaScript
# bundle that ships to the browser, so anyone can read them with View Source.
# API keys, mailing credentials and Stripe secret keys belong in the backend's
# environment and nowhere else. There is no exception to this.

# ---------------------------------------------------------------------- mode
# Leave BLANK for demo mode. Demo mode is the safe default: the app composes
# and prints letters entirely in the browser and has no code path that can mail
# anything or take a payment.
#
# Set to the deployed API's origin (no trailing slash) to enable live mailing:
#   VITE_API_BASE_URL=https://api.whyisthislighton.com
VITE_API_BASE_URL=

# ----------------------------------------------------------------- base path
# "/" for a custom domain (www.whyisthislighton.com) or a user/org GitHub page.
# "/<repo-name>/" for a project page at https://<user>.github.io/<repo>/.
# The deploy workflow sets this automatically; you rarely need it locally.
VITE_BASE_PATH=/

# -------------------------------------------------------------------- contact
VITE_CONTACT_EMAIL=hello@whyisthislighton.com
