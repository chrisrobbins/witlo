{
  "name": "whyisthislighton-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static React front end for Why Is This Light On? — a Vite build served from the domain root, fully usable in demo mode with no backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:content": "node ../scripts/sync-content.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@testing-library/jest-dom": "^6.6.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
